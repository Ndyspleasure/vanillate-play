# Optional. Public site URL used to generate sitemap.xml at build time (Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL automatically, so this is only needed elsewhere).
SITE_URL=

# Optional. Endpoint that receives anonymous, batched gameplay events (JSON via sendBeacon).
# Leave empty to disable analytics entirely. Never put secrets here: VITE_* values ship to the browser.
VITE_ANALYTICS_URL=
